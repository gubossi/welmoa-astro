---
const {
  title = 'Welmoa',
  description = '사회복지 실무자를 위한 도구와 콘텐츠 플랫폼',
  canonical,
  image,
  article,
} = Astro.props;

// 모든 공개 페이지가 welmoa.kr 기준의 self-canonical을 갖도록 정규화합니다.
// www / 과거 서브도메인 등 호스트 차이로 동일 콘텐츠가 분산되는 것을 방지합니다.
const canonicalUrl = canonical
  ? new URL(canonical, 'https://welmoa.kr').href
  : new URL(Astro.url.pathname, 'https://welmoa.kr').href;

const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description,
  image: image ? new URL(image, Astro.site).href : undefined,
  datePublished: article.pubDate.toISOString(),
  dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
  mainEntityOfPage: canonicalUrl,
  author: {
    '@type': 'Person',
    name: article.author,
    url: 'https://welmoa.kr/about/',
    jobTitle: '사회복지사',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Welmoa',
    url: 'https://welmoa.kr/',
  },
};
---

<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
  {article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
  {article?.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4TNGJX9WB9"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-4TNGJX9WB9');
  </script>

  <!-- Naver Analytics -->
  <script src="https://wcs.pstatic.net/wcslog.js"></script>
  <script is:inline>
    if (!window.wcs_add) window.wcs_add = {};
    window.wcs_add["wa"] = "c4e4f76e4b7f40";

    if (window.wcs) {
      wcs_do();
    }
  </script>

  <link rel="stylesheet" href="/styles/global.css?v=20260802-5" />
</head>

  <body>
    <header class="site-header">
<div class="container header-inner">
  <div class="brand-wrap">
    <a class="brand" href="/">Welmoa</a>
    <span class="brand-divider">|</span>
    <span class="brand-tagline">사회복지 실무자를 위한 정보와 도구 플랫폼</span>
  </div>

<nav class="header-nav" aria-label="주요 메뉴">
        <a href="/">홈</a>
        <a href="/blog/">콘텐츠</a>
        <a href="/tools/">도구</a>
        <a href="/about/">소개</a>
        <button
          class="global-search-toggle"
          type="button"
          aria-label="콘텐츠 검색 열기"
          aria-expanded="false"
          aria-controls="globalSearchPanel"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m16.5 16.5 4 4"></path>
          </svg>
          <span class="global-search-label">검색</span>
        </button>
      </nav>
    </div>
    <div id="globalSearchPanel" class="global-search-panel" hidden>
      <form class="container global-search-form" action="/blog/" method="get" role="search">
        <label for="globalSearchInput">콘텐츠 검색</label>
        <div class="global-search-field">
          <input
            id="globalSearchInput"
            name="q"
            type="search"
            placeholder="제목, 설명 또는 분류로 검색해 보세요"
            autocomplete="off"
          />
          <button type="submit">검색</button>
        </div>
      </form>
    </div>
  </header>

    <main>
      <slot />
    </main>

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-copy">
      <div><a href="/feedback/" aria-label="Welmoa 운영자 화면" style="color:inherit;text-decoration:none">© Welmoa.</a> 사회복지 실무자를 위한 정보와 도구 플랫폼</div>
      <p>본 사이트는 사회복지 실무 정보 제공을 목적으로 운영됩니다.</p>
    </div>
    <div class="footer-links">
      <a href="/about/">소개</a>
      <a href="/blog/">콘텐츠</a>
      <a href="/tools/">도구</a>
      <a href="/privacy/">개인정보처리방침</a>
      <a href="/terms/">이용약관</a>
    </div>
  </div>
</footer>

<script type="module">
  const searchToggle = document.querySelector('.global-search-toggle');
  const searchPanel = document.querySelector('#globalSearchPanel');
  const globalSearchInput = document.querySelector('#globalSearchInput');

  const closeGlobalSearch = () => {
    if (!searchToggle || !searchPanel) return;

    searchPanel.hidden = true;
    searchToggle.setAttribute('aria-expanded', 'false');
    searchToggle.setAttribute('aria-label', '콘텐츠 검색 열기');
  };

  searchToggle?.addEventListener('click', () => {
    if (!searchPanel) return;

    const willOpen = searchPanel.hidden;
    searchPanel.hidden = !willOpen;
    searchToggle.setAttribute('aria-expanded', String(willOpen));
    searchToggle.setAttribute('aria-label', willOpen ? '콘텐츠 검색 닫기' : '콘텐츠 검색 열기');

    if (willOpen) globalSearchInput?.focus();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && searchPanel && !searchPanel.hidden) {
      closeGlobalSearch();
      searchToggle?.focus();
    }
  });

  const hasMermaidBlock = Array.from(document.querySelectorAll('pre code')).some((block) => {
    const text = block.textContent.trim();
    const className = block.className || '';

    return (
      className.includes('language-mermaid') ||
      text.startsWith('timeline') ||
      text.startsWith('flowchart') ||
      text.startsWith('pie') ||
      text.startsWith('gantt') ||
      text.startsWith('mindmap') ||
      text.startsWith('sequenceDiagram')
    );
  });

  if (hasMermaidBlock) {
    const mermaid = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');

    mermaid.default.initialize({
      startOnLoad: false,
      theme: 'default',
      securityLevel: 'loose'
    });

    const blocks = Array.from(document.querySelectorAll('pre code')).filter((block) => {
      const text = block.textContent.trim();
      const className = block.className || '';

      return (
        className.includes('language-mermaid') ||
        text.startsWith('timeline') ||
        text.startsWith('flowchart') ||
        text.startsWith('pie') ||
        text.startsWith('gantt') ||
        text.startsWith('mindmap') ||
        text.startsWith('sequenceDiagram')
      );
    });

    blocks.forEach((block) => {
      const pre = block.closest('pre');
      const div = document.createElement('div');

      div.className = 'mermaid';
      div.textContent = block.textContent;

      pre.replaceWith(div);
    });

    mermaid.default.run({
      querySelector: '.mermaid'
    });
  }
</script>

  </body>
</html>
