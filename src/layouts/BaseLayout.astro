---
const {
  title = 'Welmoa',
  description = '사회복지 실무자를 위한 도구와 콘텐츠 플랫폼',
} = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <header class="site-header">
     <div class="container header-inner">
      <a class="brand" href="https://welmoa.kr/">Welmoa</a>
      <nav>
       <a href="https://welmoa.kr/">홈</a>
       <a href="https://tools.welmoa.kr/tools/">도구</a>
       <a href="https://blog.welmoa.kr/blog/">콘텐츠</a>
       <a href="https://welmoa.kr/about/">소개</a>
       <a href="https://welmoa.kr/privacy/">개인정보처리방침</a>
       <a href="https://welmoa.kr/terms/">이용약관</a>
      </nav>
     </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 Welmoa. All rights reserved.</p>
      </div>
    </footer>
  </body>
</html>