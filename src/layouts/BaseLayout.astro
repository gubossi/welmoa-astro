---
const {
  title = 'Welmoa',
  description = '사회복지 실무자를 위한 도구와 콘텐츠 플랫폼',
} = Astro.props;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="stylesheet" href="/styles/global.css" />
  </head>

  <body>
    <header class="site-header">
<div class="container header-inner">
  <div class="brand-wrap">
    <a class="brand" href="https://welmoa.kr/">Welmoa</a>
    <span class="brand-divider"></span>
    <span class="brand-tagline"> 사회복지 실무자를 위한 정보와 도구 플랫폼</span>
  </div>

  <nav class="site-nav">
       <a href="https://welmoa.kr/">홈</a>
       <a href="https://tools.welmoa.kr/tools/">도구</a>
       <a href="https://blog.welmoa.kr/blog/">콘텐츠</a>
       <a href="https://welmoa.kr/about/">소개</a>
       <a href="https://welmoa.kr/privacy/">개인정보처리방침</a>
       <a href="https://welmoa.kr/terms/">이용약관</a>
      </nav>
     </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
     <div class="container footer-inner">
       <div>
        © Welmoa. 사회복지 실무자를 위한 도구와 정보 플랫폼
       </div>

       <div class="footer-links">
         <a href="https://welmoa.kr/about/">소개</a>
         <a href="https://welmoa.kr/privacy/">개인정보처리방침</a>
         <a href="https://welmoa.kr/terms/">이용약관</a>
         <a href="https://blog.welmoa.kr/blog/">콘텐츠</a>
       </div>
     </div>
    </footer>

<script type="module">
  import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

  mermaid.initialize({
    startOnLoad: false,
    theme: 'default',
    securityLevel: 'loose'
  });

  const blocks = Array.from(document.querySelectorAll('pre code')).filter((block) => {
    const text = block.textContent.trim();
    const className = block.className || '';

    return (
      className.includes('language-mermaid') ||
      text.startsWith('timeline') ||
      text.startsWith('flowchart') ||
      text.startsWith('pie') ||
      text.startsWith('gantt') ||
      text.startsWith('mindmap') ||
      text.startsWith('sequenceDiagram')
    );
  });

  blocks.forEach((block) => {
    const pre = block.closest('pre');
    const div = document.createElement('div');

    div.className = 'mermaid';
    div.textContent = block.textContent;

    pre.replaceWith(div);
  });

  mermaid.run({
    querySelector: '.mermaid'
  });
</script>

  </body>
</html>
