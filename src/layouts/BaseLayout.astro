---
const {
  title = 'Welmoa',
  description = '사회복지 실무자를 위한 도구와 콘텐츠 플랫폼',
  canonical,
  image,
  article,
} = Astro.props;

const jsonLd = article && {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.title,
  description,
  image: image ? new URL(image, Astro.site).href : undefined,
  datePublished: article.pubDate.toISOString(),
  dateModified: (article.updatedDate ?? article.pubDate).toISOString(),
  mainEntityOfPage: canonical,
  author: {
    '@type': 'Person',
    name: article.author,
    url: 'https://welmoa.kr/about/',
    jobTitle: '사회복지사',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Welmoa',
    url: 'https://welmoa.kr/',
  },
};
---

<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  {canonical && <meta property="og:url" content={canonical} />}
  {image && <meta property="og:image" content={new URL(image, Astro.site).href} />}
  {article && <meta property="article:published_time" content={article.pubDate.toISOString()} />}
  {article?.updatedDate && <meta property="article:modified_time" content={article.updatedDate.toISOString()} />}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-4TNGJX9WB9"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-4TNGJX9WB9');
  </script>

  <!-- Naver Analytics -->
  <script src="https://wcs.pstatic.net/wcslog.js"></script>
  <script is:inline>
    if (!window.wcs_add) window.wcs_add = {};
    window.wcs_add["wa"] = "c4e4f76e4b7f40";

    if (window.wcs) {
      wcs_do();
    }
  </script>

  <link rel="stylesheet" href="/styles/global.css" />
</head>

  <body>
    <header class="site-header">
<div class="container header-inner">
  <div class="brand-wrap">
    <a class="brand" href="https://welmoa.kr/">Welmoa</a>
    <span class="brand-divider">|</span>
    <span class="brand-tagline">사회복지 실무자를 위한 정보와 도구 플랫폼</span>
  </div>

<nav>
        <a href="https://welmoa.kr/">홈</a>
        <a href="https://blog.welmoa.kr/blog/">콘텐츠</a>
        <a href="https://tools.welmoa.kr/tools/">도구</a>
        <a href="https://tools.welmoa.kr/about/">소개</a>
      </nav>
    </div>
  </header>

    <main>
      <slot />
    </main>

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-copy">
      <div>© Welmoa. 사회복지 실무자를 위한 정보와 도구 플랫폼</div>
      <p>본 사이트는 사회복지 실무 정보 제공을 목적으로 운영됩니다.</p>
    </div>
    <div class="footer-links">
      <a href="https://welmoa.kr/about/">소개</a>
      <a href="https://blog.welmoa.kr/blog/">콘텐츠</a>
      <a href="https://welmoa.kr/privacy/">개인정보처리방침</a>
      <a href="https://welmoa.kr/terms/">이용약관</a>
    </div>
  </div>
</footer>

<script type="module">
  const hasMermaidBlock = Array.from(document.querySelectorAll('pre code')).some((block) => {
    const text = block.textContent.trim();
    const className = block.className || '';

    return (
      className.includes('language-mermaid') ||
      text.startsWith('timeline') ||
      text.startsWith('flowchart') ||
      text.startsWith('pie') ||
      text.startsWith('gantt') ||
      text.startsWith('mindmap') ||
      text.startsWith('sequenceDiagram')
    );
  });

  if (hasMermaidBlock) {
    const mermaid = await import('https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs');

    mermaid.default.initialize({
      startOnLoad: false,
      theme: 'default',
      securityLevel: 'loose'
    });

    const blocks = Array.from(document.querySelectorAll('pre code')).filter((block) => {
      const text = block.textContent.trim();
      const className = block.className || '';

      return (
        className.includes('language-mermaid') ||
        text.startsWith('timeline') ||
        text.startsWith('flowchart') ||
        text.startsWith('pie') ||
        text.startsWith('gantt') ||
        text.startsWith('mindmap') ||
        text.startsWith('sequenceDiagram')
      );
    });

    blocks.forEach((block) => {
      const pre = block.closest('pre');
      const div = document.createElement('div');

      div.className = 'mermaid';
      div.textContent = block.textContent;

      pre.replaceWith(div);
    });

    mermaid.default.run({
      querySelector: '.mermaid'
    });
  }
</script>

  </body>
</html>
