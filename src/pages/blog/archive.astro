---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="전체 글 보기 | Welmoa"
  description="Welmoa 사회복지 실무 콘텐츠 전체 목록"
>
  <section class="container section">
    <a class="back-link" href="/blog/">← 콘텐츠 메인</a>

    <div class="badge">전체 글</div>
    <h1 class="page-title">Welmoa 콘텐츠 전체 목록</h1>
    <p class="page-desc">
      사회복지 실무자를 위한 급여, 노무, 행정, 공모사업, 프로그램 운영 콘텐츠를 최신순으로 확인할 수 있습니다.
    </p>

    <div class="post-list">
      {posts.map((post) => (
        <article class="list-card">
          <div>
            <a class="post-category" href={`/blog/category/${post.data.category}/`}>
              {post.data.category}
            </a>
            <h3>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
          </div>
          <span>{post.data.pubDate.toLocaleDateString('ko-KR')}</span>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>