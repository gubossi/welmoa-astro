---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => {
    const dateDiff =
      new Date(b.data.pubDate).getTime() -
      new Date(a.data.pubDate).getTime();

    if (dateDiff !== 0) return dateDiff;

    return b.id.localeCompare(a.id);
  });

const featured = posts
  .filter((post) => post.data.featured)
  .slice(0, 3);

const featuredIds = new Set(featured.map((post) => post.id));

const latest = posts
  .filter((post) => !featuredIds.has(post.id))
  .slice(0, 9);
const allSearchPosts = posts.filter(
  (post) => !featuredIds.has(post.id)
);
const categories = [...new Set(posts.map((post) => post.data.category))];
---

<BaseLayout
  title="사회복지 실무 콘텐츠 | Welmoa"
  description="사회복지 실무자를 위한 급여, 노무, 행정, 공모사업, 프로그램 운영 콘텐츠 모음"
>
  <section class="blog-hero">
    <div class="container">
      <div class="badge">Welmoa 콘텐츠</div>
      <h1>사회복지 실무자를 위한<br />급여 · 노무 · 행정 아카이브</h1>
      <p>
        현장에서 자주 찾는 급여, 근로기준, 행정문서, 공모사업 정보를
        실무자 관점에서 정리합니다.
      </p>

      <div class="quick-links">
        {categories.map((category) => (
          <a href={`/blog/category/${category}/`}>{category}</a>
        ))}
      </div>
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div>
        <h2>추천 콘텐츠</h2>
        <p>처음 방문한 실무자가 먼저 보면 좋은 글입니다.</p>
      </div>
    </div>

    <div class="featured-grid">
      {featured.map((post) => (
        <article class="featured-card">
<img
  class="card-thumb"
  src={
    post.data.category.includes('급여')
      ? '/images/categories/salary.webp'
      : post.data.category.includes('인사') || post.data.category.includes('노무')
      ? '/images/categories/labor.webp'
      : post.data.category.includes('행정') || post.data.category.includes('회계')
      ? '/images/categories/admin.webp'
      : post.data.category.includes('사업운영')
      ? '/images/categories/grant.webp'
      : post.data.category.includes('AI')
      ? '/images/categories/ai.webp'
      : '/images/categories/default.webp'
  }
  alt={post.data.category}
/>
          <a class="post-category" href={`/blog/category/${post.data.category}/`}>
            {post.data.category}
          </a>
          <h3>
            <a href={`/blog/${post.id}/`}>{post.data.title}</a>
          </h3>
          <p>{post.data.description}</p>
          <span>{post.data.pubDate.toLocaleDateString('ko-KR')}</span>
        </article>
      ))}
    </div>
  </section>

  <section class="container section">
    <div class="section-head">
      <div>
        <h2>전체 콘텐츠</h2>
        <p>최신순으로 정리된 Welmoa 실무 콘텐츠입니다.</p>
      </div>
      <div class="search-box">
        <input
          id="postSearch"
          type="search"
          placeholder="제목이나 설명으로 검색해 보세요"
          aria-label="콘텐츠 검색"
        />
      </div>
    </div>

    <div class="default-posts">
     <div class="post-list">
      {latest.map((post) => (
        <article class="list-card">
<img
  class="card-thumb"
  src={
    post.data.category.includes('급여')
      ? '/images/categories/salary.webp'
      : post.data.category.includes('인사') || post.data.category.includes('노무')
      ? '/images/categories/labor.webp'
      : post.data.category.includes('행정') || post.data.category.includes('회계')
      ? '/images/categories/admin.webp'
      : post.data.category.includes('사업운영')
      ? '/images/categories/grant.webp'
      : post.data.category.includes('AI')
      ? '/images/categories/ai.webp'
      : '/images/categories/default.webp'
  }
  alt={post.data.category}
/>
          <div>
            <a class="post-category" href={`/blog/category/${post.data.category}/`}>
              {post.data.category}
            </a>
            <h3>
              <a href={`/blog/${post.id}/`}>{post.data.title}</a>
            </h3>
            <p>{post.data.description}</p>
          </div>
          <span>{post.data.pubDate.toLocaleDateString('ko-KR')}</span>
        </article>
      ))}
     </div>
    </div>
    <div class="search-results" hidden>
     {allSearchPosts.map((post) => (
      <article class="list-card search-card">
<img
  class="card-thumb"
  src={
    post.data.category.includes('급여')
      ? '/images/categories/salary.webp'
      : post.data.category.includes('인사') || post.data.category.includes('노무')
      ? '/images/categories/labor.webp'
      : post.data.category.includes('행정') || post.data.category.includes('회계')
      ? '/images/categories/admin.webp'
      : post.data.category.includes('사업운영')
      ? '/images/categories/grant.webp'
      : post.data.category.includes('AI')
      ? '/images/categories/ai.webp'
      : '/images/categories/default.webp'
  }
  alt={post.data.category}
/>
      <div>
        <a class="post-category" href={`/blog/category/${post.data.category}/`}>
          {post.data.category}
        </a>
        <h3>
          <a href={`/blog/${post.id}/`}>{post.data.title}</a>
        </h3>
        <p>{post.data.description}</p>
      </div>
      <span>{post.data.pubDate.toLocaleDateString('ko-KR')}</span>
      </article>
     ))}
    </div>
    <div class="more-actions">
      <a class="btn secondary" href="/blog/archive/">전체 글 보기</a>
    </div>
  </section>
<script>
  const input = document.querySelector('#postSearch');
  const defaultPosts = document.querySelector('.default-posts');
  const searchResults = document.querySelector('.search-results');
  const searchCards = document.querySelectorAll('.search-card');

  input?.addEventListener('input', (e) => {
    const keyword = e.target.value.toLowerCase().trim();

    if (keyword === '') {
      defaultPosts.style.display = 'block';
      searchResults.hidden = true;
      return;
    }

    defaultPosts.style.display = 'none';
    searchResults.hidden = false;

    searchCards.forEach((card) => {
      const text = card.textContent.toLowerCase();
      card.style.display = text.includes(keyword) ? 'grid' : 'none';
    });
  });
</script>
</BaseLayout>
