---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);

  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const canonical = new URL(`/blog/${post.id}/`, Astro.site).href;

const tocHeadings = headings.filter((heading) => heading.depth === 2);
const tocSplitIndex = Math.ceil(tocHeadings.length / 2);
const tocLeft = tocHeadings.slice(0, tocSplitIndex);
const tocRight = tocHeadings.slice(tocSplitIndex);

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => {
    const dateDiff =
      new Date(b.data.pubDate).getTime() -
      new Date(a.data.pubDate).getTime();

    if (dateDiff !== 0) return dateDiff;

    return b.id.localeCompare(a.id);
  });

const currentIndex = posts.findIndex((p) => p.id === post.id);

const prevPost = posts[currentIndex + 1];
const nextPost = posts[currentIndex - 1];
---

<BaseLayout
  title={`${post.data.title} | Welmoa`}
  description={post.data.description}
  canonical={canonical}
  image={post.data.heroImage ?? post.data.thumbnail}
  article={post.data}
>
  <section class="container section">
    <article class="post-detail">
      <a class="back-link" href="/blog/">← 콘텐츠 목록</a>

      <a class="post-category" href={`/blog/category/${post.data.category}/`}>
        {post.data.category}
      </a>

      <h1>{post.data.title}</h1>
      <p class="post-lead">{post.data.description}</p>

      <div class="post-meta">
        <span>게시 <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toLocaleDateString('ko-KR')}</time></span>
        {post.data.updatedDate && (
          <span>최종 검토 <time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toLocaleDateString('ko-KR')}</time></span>
        )}
      </div>

      <aside class="author-profile" aria-label="작성자 정보">
        <div>
          <strong>{post.data.author}</strong>
          <p>노인복지관·기업 사회공헌·종합사회복지관·장애인복지관 현장을 경험한 18년차 사회복지사가 공식 자료와 현장 경험을 바탕으로 작성하고 검토합니다.</p>
          <a href="https://welmoa.kr/about/">운영자와 콘텐츠 작성 원칙 보기 →</a>
        </div>
      </aside>

<img
  class="post-hero-image"
  src={post.data.heroImage}
  alt={post.data.title}
  width="1200"
  height="630"
  loading="eager"
  fetchpriority="high"
  decoding="async"
/>

      <hr />

      <div class="post-content">
        {tocHeadings.length > 0 && (
          <nav class="post-toc" aria-label="목차">
            <h2>목차</h2>
<div class:list={{ 'post-toc-grid': tocHeadings.length >= 6 }}>
  <ol start="1">
    {tocLeft.map((heading) => (
      <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
    ))}
  </ol>

  {tocRight.length > 0 && (
    <ol start={tocSplitIndex + 1}>
      {tocRight.map((heading) => (
        <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
      ))}
    </ol>
  )}
</div>
          </nav>
        )}
        <Content />
      </div>

      <div data-welmoa-engagement-mount data-page-type="content"></div>
      <script
        is:inline
        defer
        src="https://tools.welmoa.kr/assets/engagement.js?v=20260802-3"
        data-welmoa-engagement="content"
      ></script>

      <nav class="post-nav" aria-label="이전글 다음글">
        {prevPost && (
          <a class="post-nav-card prev" href={`/blog/${prevPost.id}/`}>
            <span>← 이전글</span>
            <strong>{prevPost.data.title}</strong>
          </a>
        )}

        {nextPost && (
          <a class="post-nav-card next" href={`/blog/${nextPost.id}/`}>
            <span>다음글 →</span>
            <strong>{nextPost.data.title}</strong>
          </a>
        )}
      </nav>
    </article>
  </section>
</BaseLayout>

<style>
  @media (min-width: 769px) {
    :global(.post-toc-grid) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 40px;
      align-items: start;
    }
  }
</style>
